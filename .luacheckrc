-- luacheck settings for Gotta Queue 'Em All (https://github.com/lunarmodules/luacheck).
-- Run from this folder:  luacheck .
-- WoW runs Lua 5.1. read_globals: the WoW API and Blizzard UI names the addon
-- uses, each checked against Blizzard's UI source (12.1.5); a name missing
-- here is reported as undefined, which is how typos show up. Add a new API
-- name here once it is confirmed to exist.
std = "lua51"
max_line_length = false
exclude_files = { "tools/**", ".git/**", "_backup/**" }
ignore = {
    "212/self",   -- unused self in methods and scripts
}

-- Set by the addon: saved variables, slash command, key binding, compartment.
globals = {
    "GottaQueueEmAllDB",
    "GottaQueueEmAll_Toggle",
    "GottaQueueEmAll_OnAddonCompartmentClick",
    "SLASH_GOTTAQUEUEEMALL1",
    "SLASH_GOTTAQUEUEEMALL2",
    "BINDING_HEADER_GOTTAQUEUEEMALL",
    "SlashCmdList",
}

read_globals = {
