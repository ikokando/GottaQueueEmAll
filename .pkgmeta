package-as: GottaQueueEmAll

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - .luacheckrc
  - tools
  - media/screenshots
  # PNG logos are for CurseForge / GitHub only; the game uses logo-qlens-mark.tga.
  - media/logo-qlens.png
  - media/logo-qlens-mark.png
